{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/privateBike/hdfcbiketransaction", "destination": "/api/payment/callback" },
    { "source": "/privateCar/hdfccartransaction",   "destination": "/api/payment/callback" },
    { "source": "/digit/kyc-return",      "destination": "/payment/return.html" },
    { "source": "/digit/payment-return",  "destination": "/payment/return.html" }
  ]
}
